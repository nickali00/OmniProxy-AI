# Cambiare questa chiave prima del primo avvio. Viene salvato solo il suo hash.
BOOTSTRAP_API_KEY=sk-local-change-me-with-a-long-random-secret

GATEWAY_PORT=8000
AI_GATEWAY_NETWORK=omni-proxy-ai-network
LOG_LEVEL=INFO
# Funzione sperimentale non esposta nella prima release pubblica.
BUILD_ENABLED=false

# Modello effettivo usato dagli alias pubblici "base" e "local".
# URL opzionale prioritario; se assente viene provato il container `ollama`
# e poi l'host Docker.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=10m
OLLAMA_THINK=false
OLLAMA_REQUEST_TIMEOUT_SECONDS=300

# Lasciare il database sul volume Docker persistente.
DATABASE_PATH=/data/omni_proxy.sqlite3
TIKTOKEN_ENCODING=cl100k_base

# I client vivono nei sidecar di OmniProxy, non nella home dell'host.
CODEX_CLIENT_LABEL=Codex CLI 0.145.0
GEMINI_CLIENT_LABEL=Antigravity CLI 1.1.7
CLAUDE_CLIENT_LABEL=Claude Code 2.1.218

# Sidecar ufficiali isolati. Nessuno espone porte sull'host.
CODEX_CLI_VERSION=0.145.0
CODEX_AUTH_TTL_MS=600000
ANTIGRAVITY_CLI_VERSION=1.1.7
ANTIGRAVITY_AUTH_TTL_MS=600000
CLAUDE_CODE_VERSION=2.1.218
CLAUDE_AUTH_TTL_MS=300000
PROVIDER_BROKER_TIMEOUT_SECONDS=25
PROVIDER_COMPLETION_TIMEOUT_SECONDS=600
PROVIDER_EXECUTION_TIMEOUT_MS=600000

# Vault locale disponibile per futuri provider che richiedano segreti
# applicativi. Le sessioni dei client ufficiali restano nei rispettivi volumi.
PROVIDER_VAULT_KEY=
PROVIDER_VAULT_KEY_PATH=/vault/omniproxy-vault.key

# Protezione DNS-rebinding della dashboard locale.
DASHBOARD_ALLOWED_HOSTS=127.0.0.1,localhost,gateway
