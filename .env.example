# Cambiare questa chiave prima del primo avvio. Viene salvato solo il suo hash.
BOOTSTRAP_API_KEY=sk-local-change-me-with-a-long-random-secret

# Mantiene dashboard e API accessibili soltanto dall'host. Impostare 0.0.0.0
# esclusivamente su una LAN fidata, con firewall limitato all'IP del client.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8000
AI_GATEWAY_NETWORK=omni-proxy-ai-network
LOG_LEVEL=INFO
# Funzione sperimentale non esposta nella prima release pubblica.
BUILD_ENABLED=false

# Accesso remoto: usare scripts.prepare_https e il profilo HTTPS documentato.
# Protegge la dashboard senza invalidare le chiavi personali già esistenti.
DASHBOARD_AUTH_REQUIRED=false
REQUIRE_HTTPS=false
AUTH_FAILURES_PER_MINUTE=30

# Workspace agente: radici esplicitamente montate e autorizzate, separate da :.
# Vuoto disabilita la registrazione; nessun percorso host viene montato da solo.
JOB_WORKSPACE_ROOTS=
JOBS_MAX_ACTIVE_PER_KEY=4
JOBS_LEASE_SECONDS=60
# 0 conserva la cronologia; valore positivo elimina solo job terminali sicuri.
JOBS_RETENTION_DAYS=0
JOB_TEST_LEASE_SECONDS=60
JOB_TEST_TIMEOUT_SECONDS=30
TOKEN_BUDGET_TIMEZONE=Europe/Rome
DEFAULT_BUDGET_OUTPUT_TOKENS=4096
# Limiti tecnici globali, distinti dai tetti token opzionali delle chiavi.
MAX_REQUEST_BODY_BYTES=33554432
REQUEST_BODY_TIMEOUT_SECONDS=30
MAX_CONCURRENT_API_REQUESTS=16
FILE_MAX_BYTES=20971520
FILE_STORAGE_BYTES_PER_KEY=104857600
FILE_RETENTION_DAYS=7
FILE_PROCESSING_TIMEOUT_SECONDS=60
FILE_OCR_LANGUAGES=eng
FILE_MAX_VIDEO_SECONDS=120
FILE_VIDEO_FRAMES=4
FILE_MAX_AUDIO_SECONDS=300
# Audio: backend compatibile OpenAI, oppure modello locale preinstallato.
# Il percorso locale deve essere leggibile nel container; nessun download automatico.
ENABLE_LOCAL_AUDIO=false
AUDIO_BACKEND_URL=
AUDIO_API_KEY=
AUDIO_MODEL=whisper-1
AUDIO_LOCAL_MODEL=
AUDIO_TIMEOUT_SECONDS=120
AUDIO_INPUT_TOKENS_PER_SECOND=50
SPEECH_TIMEOUT_SECONDS=45
SPEECH_MAX_SECONDS=120
SPEECH_OUTPUT_TOKENS_PER_SECOND=50
# Generazione immagini: upstream oppure modello locale preinstallato.
# Runtime neurale CPU opzionale, pesi separati e mai scaricati dal gateway.
ENABLE_LOCAL_IMAGES=false
IMAGE_BACKEND_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_LOCAL_MODEL=
IMAGE_LOCAL_STEPS=20
IMAGE_TIMEOUT_SECONDS=120
IMAGE_MAX_PIXELS=1572864
IMAGE_OUTPUT_TOKENS_PER_MEGAPIXEL=4096

# Modello effettivo usato dagli alias pubblici "base" e "local".
# URL opzionale prioritario; se assente viene provato il container `ollama`
# e poi l'host Docker.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=10m
OLLAMA_THINK=false
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_REQUEST_TIMEOUT_SECONDS=300

# Upstream OpenAI-compatible opzionale, alias pubblico "upstream".
# URL base termina in /v1; impostare modello e chiave secondo il server scelto.
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=
# Deployment multipli: JSON amministrativo lato server, non passato dai client.
# Esempio senza segreti in docs/wiki/deployment-upstream.md.
UPSTREAM_DEPLOYMENTS_JSON=[]

# Lasciare il database sul volume Docker persistente.
DATABASE_PATH=/data/omni_proxy.sqlite3
# Personale: lasciare vuoto. PostgreSQL: DSN privato fornito lato server.
DATABASE_URL=
# Activer seulement après provisionnement local d'une identité opérateur.
ADMIN_AUTH_REQUIRED=false
# Telemetria opzionale: collector OTLP HTTP gestito dall'operatore.
OTEL_ENABLED=false
OTEL_ENDPOINT=
OTEL_SAMPLE_RATE=0.1
TIKTOKEN_ENCODING=cl100k_base

# I client vivono nei sidecar di OmniProxy, non nella home dell'host.
CODEX_CLIENT_LABEL=Codex CLI
GEMINI_CLIENT_LABEL=Antigravity CLI
CLAUDE_CLIENT_LABEL=Claude Code 2.1.218

# Sidecar ufficiali isolati. Nessuno espone porte sull'host.
CODEX_AUTH_TTL_MS=600000
# Versione e SHA ufficiali fissati in antigravity-broker/*.txt.
# Override amministrativi opzionali: aggiornare insieme versione e SHA.
ANTIGRAVITY_VERSION_OVERRIDE=
ANTIGRAVITY_SHA256_AMD64_OVERRIDE=
ANTIGRAVITY_SHA256_ARM64_OVERRIDE=
ANTIGRAVITY_AUTH_TTL_MS=600000
CLAUDE_CODE_VERSION=2.1.218
CLAUDE_AUTH_TTL_MS=300000
PROVIDER_BROKER_TIMEOUT_SECONDS=25
PROVIDER_COMPLETION_TIMEOUT_SECONDS=600
MCP_CONNECT_TIMEOUT_SECONDS=15
MCP_CALL_TIMEOUT_SECONDS=60
MCP_MAX_TOOL_CALLS=4
MCP_MAX_RESULT_CHARACTERS=48000
PROVIDER_EXECUTION_TIMEOUT_MS=600000

# Vault locale disponibile per futuri provider che richiedano segreti
# applicativi. Le sessioni dei client ufficiali restano nei rispettivi volumi.
PROVIDER_VAULT_KEY=
PROVIDER_VAULT_KEY_PATH=/vault/omniproxy-vault.key

# Protezione DNS-rebinding della dashboard locale.
DASHBOARD_ALLOWED_HOSTS=127.0.0.1,localhost,gateway
